{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": [
      "/_next/*",
      "/images/*",
      "/*.{png,jpg,jpeg,webp,gif,svg,ico,css,js,mjs,map,txt,xml,json,woff,woff2,ttf,mp4,webm}"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "routes": [
    {
      "route": "/_next/static/*",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    }
  ],
  "mimeTypes": {
    ".webp": "image/webp",
    ".mjs": "text/javascript"
  }
}
